<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">25.2dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:paddingStart">9.6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">5.4dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">25.2dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="HuaCCTVAppMenuAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/app_menu_pop_in</item>
        <item name="android:windowExitAnimation">@anim/app_menu_pop_out</item>
    </style>
    <style name="HuaCCTVRightMenuAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/menu_slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/menu_slide_out_right</item>
        <item name="android:activityOpenEnterAnimation">@anim/menu_slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/menu_underlay_still</item>
        <item name="android:activityCloseEnterAnimation">@anim/menu_underlay_still</item>
        <item name="android:activityCloseExitAnimation">@anim/menu_slide_out_right</item>
    </style>
    <style name="Theme.TvHome.ControlCenter" parent="Theme.TvHome">
        <item name="android:windowAnimationStyle">@style/HuaCCTVRightMenuAnimation</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
